SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your-account@example.com
SPRING_MAIL_PASSWORD=your-mail-authorization-code
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
MAIL_FROM=your-account@example.com

# 默认使用本机Ollama。若改用DeepSeek，请把地址、模型和密钥替换为远程服务配置。
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_MODEL=qwen3:8b
DEEPSEEK_API_KEY=
AI_MOCK_ENABLED=false
