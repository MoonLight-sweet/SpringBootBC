#!/bin/sh

branch=$(git symbolic-ref --quiet --short HEAD)
if [ -z "$branch" ]; then
  exit 0
fi

echo "[CodeClinic] 自动同步 GitHub: $branch"
if ! git push origin "$branch"; then
  echo "[CodeClinic] Git传输失败，改用GitHub API同步"
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/github-api-sync.ps1
fi
