#!/bin/sh

branch=$(git symbolic-ref --quiet --short HEAD)
if [ -z "$branch" ]; then
  exit 0
fi

echo "[CodeClinic] 自动同步 GitHub: $branch"
attempt=1
while [ "$attempt" -le 3 ]; do
  if git push origin "$branch"; then
    echo "[CodeClinic] GitHub同步完成"
    exit 0
  fi
  echo "[CodeClinic] 第${attempt}次推送失败，5秒后重试"
  sleep 5
  attempt=$((attempt + 1))
done

echo "[CodeClinic] 网络暂不可用，后台自动同步任务稍后继续补推"
exit 0
