{
  "info": {"name": "CodeClinic V1.1 API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}, {"key": "runUsername", "value": ""}, {"key": "resetCode", "value": ""}, {"key": "token", "value": ""}, {"key": "questionId", "value": "1"}],
  "item": [
    {"name": "注册", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"12345678\",\n  \"email\": \"{{runUsername}}@example.com\",\n  \"displayName\": \"Postman用户\"\n}"}, "url": "{{baseUrl}}/api/user/register"}, "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('runUsername', 'postman_' + Date.now());"]}}, {"listen": "test", "script": {"exec": ["pm.test('注册返回200', function () { pm.response.to.have.status(200); });"]}}]},
    {"name": "申请找回密码验证码", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{runUsername}}@example.com\"\n}"}, "url": "{{baseUrl}}/api/user/password/reset-code"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('验证码接口返回200', function () { pm.response.to.have.status(200); });", "pm.test('开发模式返回6位验证码', function () { pm.expect(pm.response.json().data.demoCode).to.match(/^\\d{6}$/); });", "pm.collectionVariables.set('resetCode', pm.response.json().data.demoCode);"]}}]},
    {"name": "重置密码", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{runUsername}}@example.com\",\n  \"code\": \"{{resetCode}}\",\n  \"newPassword\": \"87654321\"\n}"}, "url": "{{baseUrl}}/api/user/password/reset"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('重置密码返回200', function () { pm.response.to.have.status(200); });", "pm.test('业务状态为200', function () { pm.expect(pm.response.json().code).to.eql(200); });"]}}]},
    {"name": "使用新密码登录", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"87654321\"\n}"}, "url": "{{baseUrl}}/api/user/login"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('新密码登录返回200', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('token', pm.response.json().data.token);"]}}]},
    {"name": "新增错题", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Java数组越界\",\n  \"description\": \"输出数组最后一个元素\",\n  \"language\": \"Java\",\n  \"code\": \"int[] arr = {1,2,3}; System.out.println(arr[3]);\",\n  \"errorMessage\": \"ArrayIndexOutOfBoundsException\",\n  \"actualOutput\": \"\",\n  \"expectedOutput\": \"3\"\n}"}, "url": "{{baseUrl}}/api/wrong-question"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('新增错题返回200', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('questionId', pm.response.json().data);"]}}]},
    {"name": "AI分析", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/wrong-question/{{questionId}}/analyze"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('AI分析返回200', function () { pm.response.to.have.status(200); });", "pm.test('返回错误类型', function () { pm.expect(pm.response.json().data.errorType).to.exist; });"]}}]},
    {"name": "错题列表", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/wrong-question?page=1&size=10"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('列表返回200', function () { pm.response.to.have.status(200); });"]}}]},
    {"name": "分析结果", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/analysis/{{questionId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('分析结果返回200', function () { pm.response.to.have.status(200); });"]}}]},
    {"name": "学习统计", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/statistics"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('统计返回200', function () { pm.response.to.have.status(200); });"]}}]}
  ]
}
